# Line endings are normalised in the repository and in every working tree: LF,
# always. core.autocrlf is a per-machine setting and cannot promise that, while
# this file travels with the clone — which is what CI on Linux and a grader on
# an unknown platform actually need (NFR-7, clean-clone reproducibility).
* text=auto eol=lf

# Binary assets: never normalised, never diffed as text. The vendored subset
# typefaces and the PWA icons arrive with Story 1.1.
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.webp  binary
*.pdf   binary
